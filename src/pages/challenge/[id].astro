---
import Layout from '../../components/Layout.astro';
import { getCollection } from 'astro:content';
import inventory from '../../data/inventory.json';
import externalLinks from '../../data/external-links.json';

export function getStaticPaths() {
  return inventory.filter((item) => item.kind === 'challenge').map((item) => ({ params: { id: item.id }, props: { item } }));
}
const { item } = Astro.props;
const writeups = (await getCollection('writeups')).filter((entry) => entry.data.challengeIds.includes(item.id));
const knowledge = (await getCollection('knowledge')).filter((entry) => entry.data.challengeIds.includes(item.id));
const wpLabel = writeups.length ? '本站 WP' : item.wpStatus === 'external' ? '外部参考' : '暂无 WP';
const contestWp = inventory.find((record) => record.kind === 'source' && record.extension === '.txt' && record.contest === item.contest);
const externalWp = contestWp ? externalLinks[contestWp.id as keyof typeof externalLinks] : null;
---

<Layout title={item.title} description={`${item.contest} · ${item.module} 题目附件`} active={item.module === 'Archive' ? 'archive' : item.module} pageType="题目" pageModule={item.module} wpFilter={writeups.length ? '本地 WP' : '无本站 WP'}>
  <div class="content-wrap"><header class="page-head" data-pagefind-body><div class="page-topline"><a href="/challenges/">题目索引</a><span>/</span>{item.module}</div><h1 data-pagefind-meta="title">{item.title}</h1><p>{item.contest} · {item.name}</p><div class="tag-row"><span class="tag">{item.module === 'Archive' ? '待归档' : item.module}</span><span class="tag">{wpLabel}</span>{item.encrypted && <span class="tag">附件含加密项</span>}</div></header>
    <div class="article-layout"><div class="article-main">
      <div class="path-box"><small>题目附件位置 · 相对于 学习资源 目录</small><code>{item.relativePath.replaceAll('/', '\\')}</code><button class="copy-path" data-path={item.relativePath.replaceAll('/', '\\')}>复制相对路径</button></div>
      <div class="stat-line"><span>大小 {Math.max(1, Math.round(item.bytes / 1024))} KB</span><span>归档条目 {item.archiveEntries ?? '未知'}</span><span>SHA-256 {item.sha256.slice(0, 16)}…</span></div>
      <div class="article-links"><h2>关联 WP</h2><div class="related-list">{writeups.map((entry) => <a href={`/writeup/${entry.id}/`}>{entry.data.title} · 本站整理 ↗</a>)}{!writeups.length && externalWp?.startsWith('https://') && <a href={externalWp} target="_blank" rel="noopener noreferrer">比赛外部 WP 参考 ↗</a>}</div>{!writeups.length && !externalWp && <p class="empty-state">这道题目前只有附件，尚未整理 WP。</p>}</div>
      {knowledge.length > 0 && <div class="article-links"><h2>关联知识点</h2><div class="related-list">{knowledge.map((entry) => <a href={`/knowledge/${entry.id}/`}>{entry.data.title} ↗</a>)}</div></div>}
      <div class="notice">压缩包仅建立元数据索引；本站不会自动运行附件中的程序。</div>
    </div><aside class="article-aside"><div class="aside-label">题目概况</div><a href={item.module === 'Archive' ? '/archive/' : `/module/${item.module.toLowerCase()}/`}>{item.module === 'Archive' ? '待归档' : item.module}</a><a href="/search/">搜索相关内容</a></aside></div>
  </div>
  <script>
    document.querySelectorAll<HTMLButtonElement>('.copy-path').forEach((button) => button.addEventListener('click', async () => {
      await navigator.clipboard.writeText(button.dataset.path || '');
      button.textContent = '已复制';
    }));
  </script>
</Layout>
