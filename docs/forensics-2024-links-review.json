      "items": [
        {
          "id": "Z01",
          "theme": "物理机、云主机、单机与站库或文件分离的部署范围",
          "mode": "expanded",
          "destinations": [
            {
              "articleId": "fic-case-04",
              "section": "01.1",
              "heading": "先确定部署边界与技术栈"
            }
          ],
          "boundary": "磁盘快照不自动包含远端数据库、独立云盘或对象存储；平台和技术栈由实际配置核对。"
        },
        {
          "id": "Z02",
          "theme": "Apache安装配置、网站根、虚拟主机与日志",
          "mode": "expanded",
          "destinations": [
            {
              "articleId": "fic-case-04",
              "section": "01.5",
              "heading": "实战：从 Apache 配置定位站点"
            }
          ],
          "boundary": "区分ServerRoot与DocumentRoot，沿Include和启动参数定位实际配置；存在配置不证明历史运行。"
        },
        {
          "id": "Z03",
          "theme": "Nginx主配置、包含关系、站点目录、路由和日志",
          "mode": "expanded",
          "destinations": [
            {
              "articleId": "fic-case-04",
              "section": "01.2",
              "heading": "Nginx 配置体系与包含关系"
            },
            {
              "articleId": "fic-case-04",
              "section": "01.3",
              "heading": "实战：定位网站目录与伪静态规则"
            }
          ],
          "boundary": "启用目录名不等于配置生效；离线绝对软链重定位到检材根；nginx -T不是查询历史已加载配置。"
        },
        {
          "id": "Z04",
          "theme": "Tomcat端口、部署应用、Context和访问日志",
          "mode": "expanded",
          "destinations": [
            {
              "articleId": "fic-case-04",
              "section": "01.6",
              "heading": "实战：串联 Tomcat 的端口、应用与日志"
            }
          ],
          "boundary": "核对CATALINA_BASE、Connector、Host和Context；redirectPort不等于监听；访问日志按Valve与实例路径判断。"
        },
        {
          "id": "Z05",
          "theme": "IIS站点绑定、程序路径与站点日志",
          "mode": "expanded",
          "destinations": [
            {
              "articleId": "fic-case-04",
              "section": "01.7",
              "heading": "实战：从 IIS 绑定定位程序与日志"
            }
          ],
          "boundary": "按同一site上下文关联ID、binding、application和physicalPath；W3C字段和UTC时间不能按目录名猜测。"
        },
        {
          "id": "Z06",
          "theme": "访问日志中筛选后台路径和重定向候选",
          "mode": "expanded",
          "destinations": [
            {
              "articleId": "fic-case-04",
              "section": "04.3",
              "heading": "实战：从请求筛选候选后台入口"
            }
          ],
          "boundary": "路径关键词、200或301/302不能单独证明后台登录；继续核对路由、Location、会话与业务记录。"
        },
        {
          "id": "Z07",
          "theme": "PHP网站的数据库连接配置",
          "mode": "expanded",
          "destinations": [
            {
              "articleId": "fic-case-04",
              "section": "02.3",
              "heading": "按应用类型定位连接配置"
            }
          ],
          "boundary": "配置名只是候选，沿require/include、环境、缓存和初始化读取链核对；不执行未知PHP。"
        },
        {
          "id": "Z08",
          "theme": "ASP.NET与经典ASP连接信息",
          "mode": "expanded",
          "destinations": [
            {
              "articleId": "fic-case-04",
              "section": "02.3",
              "heading": "按应用类型定位连接配置"
            }
          ],
          "boundary": "ASP.NET核对connectionStrings/configSource；经典ASP沿连接代码和include追踪，不能混为同一配置体系。"
        },
        {
          "id": "Z09",
          "theme": "Java应用中的数据库配置与部署入口",
          "mode": "expanded",
          "destinations": [
            {
              "articleId": "fic-case-04",
              "section": "02.3",
              "heading": "按应用类型定位连接配置"
            }
          ],
          "boundary": "读取JAR/WAR配置、profile、外部配置、环境与启动参数；静态提取不执行java -jar。"
        },
        {
          "id": "Z10",
          "theme": "网站重构的材料、恢复顺序与范围核验",
          "mode": "consolidated-and-linked",
